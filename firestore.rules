rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/{doc} {
      allow read: if true;
      // Ganti UID_KAMU dengan UID yang muncul di /admin → menu Keamanan
      allow write: if request.auth != null
                   && request.auth.uid == "UID_KAMU";
    }
  }
}
